generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int         @id @default(autoincrement())
  username  String      @unique
  email     String      @unique
  password  String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  watchlist Watchlist[]
  reviews   Review[]

  @@map("users")
}

model Movie {
  id         Int         @id @default(autoincrement())
  title      String
  year       Int
  director   String
  genres     String[]
  rating     Float
  duration   String
  synopsis   String      @db.Text
  poster_url String
  cast       String[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  watchlist  Watchlist[]
  reviews    Review[]

  @@map("movies")
}

model Watchlist {
  id        Int      @id @default(autoincrement())
  userId    Int
  movieId   Int
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
  @@map("watchlists")
}

model Review {
  id        Int      @id @default(autoincrement())
  userId    Int
  movieId   Int
  rating    Int
  review    String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@map("reviews")
}
